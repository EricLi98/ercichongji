+def index_benchmark(start: str, end: str) -> str:
+    """离线库里的指数买入持有（通常只有 000300.SH）。"""
+    try:
+        import data_loader
+        idx = data_loader.load_index_daily()
+        d = pd.to_datetime(idx["trade_date"].astype(str).str.replace("-", "", regex=False),
+                           format="%Y%m%d", errors="coerce")
+        m = (d >= pd.Timestamp(start)) & (d <= pd.Timestamp(end))
+        s = idx.loc[m].sort_values("trade_date")["close"]
+        return f"{s.iloc[-1] / s.iloc[0] - 1:.2%}" if len(s) > 1 else "n/a"
+    except Exception as e:
+        return f"n/a ({e})"
