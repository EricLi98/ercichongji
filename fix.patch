+def yearly(eq: pd.Series) -> pd.Series:
+    """年度收益 —— 检查是否由单一年份贡献全部收益。"""
+    y = eq.resample("YE").last() / eq.resample("YE").first() - 1
+    y.index = y.index.year
+    return y.map("{:.2%}".format)
+
